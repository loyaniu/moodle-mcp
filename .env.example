# Create your own .env file from this example file.

MOODLE_URL="https://<your-moodle-url>/webservice/rest/server.php"
MOODLE_TOKEN="<your-moodle-token>"

# Optional: directory for raw Moodle API JSON dumps (debugging only, unset by default).
# MOODLE_MCP_DEBUG_DIR="/path/to/writable/dir"

# Optional: default folder for course file downloads (default: ~/Downloads/moodle-mcp).
# MOODLE_MCP_DOWNLOAD_DIR="/path/to/downloads"
